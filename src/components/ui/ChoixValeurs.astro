---
/* Props : items, variante ("cartes" par défaut | "pastilles"), titre (facultatif). */
const { items, variante = "cartes", titre } = Astro.props;

const listeClasse =
  variante === "pastilles"
    ? "flex flex-wrap gap-2"
    : "grid gap-4 sm:grid-cols-2 lg:grid-cols-3";
---

{
  titre ? (
    <nav aria-label={titre}>
      <p class="mb-4 text-xs font-medium uppercase tracking-widest text-stone-500">{titre}</p>
      <ul class={listeClasse}>
        {items.map((item) => (
          <li class={variante === "pastilles" ? "" : "flex"}>
            {variante === "pastilles" ? (
              <a
                href={item.href}
                aria-current={item.actif ? "page" : undefined}
                class:list={[
                  "inline-block rounded-full border px-4 py-1.5 text-sm transition-colors",
                  item.actif
                    ? "border-teal-700 bg-teal-700 text-white"
                    : "border-stone-200 bg-white text-stone-700 hover:border-stone-300 hover:bg-stone-100",
                ]}
              >
                {item.label}
              </a>
            ) : (
              <a
                href={item.href}
                aria-current={item.actif ? "page" : undefined}
                class="group flex w-full flex-col justify-between rounded-xl border border-stone-200 bg-white p-5 transition hover:-translate-y-0.5 hover:border-stone-300 hover:shadow-survol"
              >
                <span class="font-serif text-2xl tracking-tight text-stone-900">{item.label}</span>
                <span class="mt-4 flex items-end justify-between gap-3">
                  <span class="text-sm text-stone-500">{item.detail}</span>
                  <span aria-hidden="true" class="text-teal-700 transition-transform group-hover:translate-x-1">→</span>
                </span>
              </a>
            )}
          </li>
        ))}
      </ul>
    </nav>
  ) : (
    <ul class={listeClasse}>
      {items.map((item) => (
        <li class={variante === "pastilles" ? "" : "flex"}>
          {variante === "pastilles" ? (
            <a
              href={item.href}
              aria-current={item.actif ? "page" : undefined}
              class:list={[
                "inline-block rounded-full border px-4 py-1.5 text-sm transition-colors",
                item.actif
                  ? "border-teal-700 bg-teal-700 text-white"
                  : "border-stone-200 bg-white text-stone-700 hover:border-stone-300 hover:bg-stone-100",
              ]}
            >
              {item.label}
            </a>
          ) : (
            <a
              href={item.href}
              aria-current={item.actif ? "page" : undefined}
              class="group flex w-full flex-col justify-between rounded-xl border border-stone-200 bg-white p-5 transition hover:-translate-y-0.5 hover:border-stone-300 hover:shadow-survol"
            >
              <span class="font-serif text-2xl tracking-tight text-stone-900">{item.label}</span>
              <span class="mt-4 flex items-end justify-between gap-3">
                <span class="text-sm text-stone-500">{item.detail}</span>
                <span aria-hidden="true" class="text-teal-700 transition-transform group-hover:translate-x-1">→</span>
              </span>
            </a>
          )}
        </li>
      ))}
    </ul>
  )
}

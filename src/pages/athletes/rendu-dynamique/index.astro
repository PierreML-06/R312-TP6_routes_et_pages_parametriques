---
export const prerender = false;

import Layout from "../../../layouts/Layout.astro";
import PageHeader from "../../../components/ui/PageHeader.astro";
import ModeSwitch from "../../../components/ui/ModeSwitch.astro";
import ChoixValeurs from "../../../components/ui/ChoixValeurs.astro";
import Encart from "../../../components/ui/Encart.astro";
import athletes from "../../../data/athletes.json";

const valeurs = [...new Set(athletes.map((d) => d.sport))].sort();
const slug = (v) => v.toLowerCase().replaceAll(" ", "-");
const items = valeurs.map((v) => ({
  href: `/athletes/rendu-dynamique/${slug(v)}`,
  label: ((v) => v.charAt(0).toUpperCase() + v.slice(1))(v),
  detail: `${athletes.filter((d) => d.sport === v).length} athlètes`,
}));
---

<Layout title="Rendu dynamique · Athlètes">
  <PageHeader surtitre="Athlètes · Rendu dynamique" titre="Rendu dynamique" intro="Ces pages ne sont pas générées au build : le serveur produit le HTML à chaque requête, à partir du slug lu dans l'URL.">
    <ModeSwitch dataset="athletes" />
  </PageHeader>

  <ChoixValeurs items={items} variante="cartes" titre="Choisir un sport" />

  <div class="mt-12">
    <Encart titre="Page rendue à la demande" ton="info">
      <p>Avec prerender = false, Astro calcule la page à chaque visite et lit le slug avec Astro.params. On retrouve ensuite la valeur d'origine en comparant les slugs.</p>
      <pre><code>{"export const prerender = false;\nconst { sport } = Astro.params;"}</code></pre>
    </Encart>
  </div>
</Layout>

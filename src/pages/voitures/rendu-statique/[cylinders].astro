---
import Layout from "../../../layouts/Layout.astro";
import PageHeader from "../../../components/ui/PageHeader.astro";
import ModeSwitch from "../../../components/ui/ModeSwitch.astro";
import ChoixValeurs from "../../../components/ui/ChoixValeurs.astro";
import GraphiqueCylindres from "../../../components/GraphiqueCylindres.astro";
import cars from "../../../data/cars.json";

// Appelée au build : une page HTML est produite pour chaque nombre de cylindres.
export function getStaticPaths() {
  const cylindres = [...new Set(cars.map((d) => d.cylinders))].sort((a, b) => a - b);
  return cylindres.map((n) => ({ params: { cylinders: String(n) } }));
}

const { cylinders } = Astro.params;
const cylindres = [...new Set(cars.map((d) => d.cylinders))].sort((a, b) => a - b);

// Valeur absente de la liste : on répond directement 404.
if (!cylindres.some((n) => String(n) === cylinders)) {
  return new Response("Nombre de cylindres inconnu", { status: 404 });
}

const items = cylindres.map((n) => ({
  href: `/voitures/rendu-statique/${n}`,
  label: `${n} cylindres`,
  actif: String(n) === cylinders,
}));
---

<Layout title={`${cylinders} cylindres · Rendu statique`}>
  <PageHeader surtitre="Voitures · Rendu statique" titre={`${cylinders} cylindres`}>
    <ModeSwitch dataset="voitures" />
  </PageHeader>

  <div class="mb-6">
    <ChoixValeurs items={items} variante="pastilles" titre="Changer de nombre de cylindres" />
  </div>

  <div class="carte">
    <GraphiqueCylindres cylinders={cylinders} />
  </div>

  <p class="mt-8">
    <a href="/voitures/rendu-statique" class="lien-fleche">Retour à la liste des cylindres</a>
  </p>
</Layout>

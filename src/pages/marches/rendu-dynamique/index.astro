---
export const prerender = false;

import Layout from "../../../layouts/Layout.astro";
import PageHeader from "../../../components/ui/PageHeader.astro";
import ModeSwitch from "../../../components/ui/ModeSwitch.astro";
import ChoixValeurs from "../../../components/ui/ChoixValeurs.astro";
import Encart from "../../../components/ui/Encart.astro";
import stocks from "../../../data/stocks.json";

const valeurs = [...new Set(stocks.map((d) => d.symbol))].sort();
const items = valeurs.map((v) => ({
  href: `/marches/rendu-dynamique/${v}`,
  label: `${v}`,
  detail: `${stocks.filter((d) => d.symbol === v).length} cours`,
}));
---

<Layout title="Rendu dynamique · Marchés">
  <PageHeader surtitre="Marchés · Rendu dynamique" titre="Rendu dynamique" intro="Ces pages ne sont pas générées au build : le serveur produit le HTML à chaque requête, à partir du symbole lu dans l'URL.">
    <ModeSwitch dataset="marches" />
  </PageHeader>

  <ChoixValeurs items={items} variante="cartes" titre="Choisir une action" />

  <div class="mt-12">
    <Encart titre="Page rendue à la demande" ton="info">
      <p>Avec prerender = false, Astro calcule la page à chaque visite et lit le paramètre avec Astro.params.</p>
      <pre><code>{`export const prerender = false;
const { symbol } = Astro.params;`}</code></pre>
    </Encart>
  </div>
</Layout>

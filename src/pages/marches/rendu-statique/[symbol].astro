---
import Layout from "../../../layouts/Layout.astro";
import PageHeader from "../../../components/ui/PageHeader.astro";
import ModeSwitch from "../../../components/ui/ModeSwitch.astro";
import ChoixValeurs from "../../../components/ui/ChoixValeurs.astro";
import GraphiqueMarche from "../../../components/GraphiqueMarche.astro";
import stocks from "../../../data/stocks.json";

// Appelée au build : une page HTML est produite pour chaque valeur.
export function getStaticPaths() {
  const valeurs = [...new Set(stocks.map((d) => d.symbol))].sort();
  return valeurs.map((v) => ({ params: { symbol: String(v) } }));
}

const { symbol } = Astro.params;
const valeurs = [...new Set(stocks.map((d) => d.symbol))].sort();

// Valeur absente de la liste : on répond directement 404.
if (!valeurs.some((v) => String(v) === symbol)) {
  return new Response("Symbole inconnu", { status: 404 });
}

const items = valeurs.map((v) => ({
  href: `/marches/rendu-statique/${v}`,
  label: `${v}`,
  actif: String(v) === symbol,
}));
---

<Layout title={`{symbol} · Rendu statique`}>
  <PageHeader surtitre="Marchés · Rendu statique" titre={`{symbol}`}>
    <ModeSwitch dataset="marches" />
  </PageHeader>

  <div class="mb-6">
    <ChoixValeurs items={items} variante="pastilles" titre="Changer d'action" />
  </div>

  <div class="carte">
    <GraphiqueMarche valeur={symbol} />
  </div>

  <p class="mt-8">
    <a href="/marches/rendu-statique" class="lien-fleche">Retour à la liste des actions</a>
  </p>
</Layout>

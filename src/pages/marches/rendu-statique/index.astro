---
import Layout from "../../../layouts/Layout.astro";
import PageHeader from "../../../components/ui/PageHeader.astro";
import ModeSwitch from "../../../components/ui/ModeSwitch.astro";
import ChoixValeurs from "../../../components/ui/ChoixValeurs.astro";
import Encart from "../../../components/ui/Encart.astro";
import stocks from "../../../data/stocks.json";

const valeurs = [...new Set(stocks.map((d) => d.symbol))].sort();
const items = valeurs.map((v) => ({
  href: `/marches/rendu-statique/${v}`,
  label: `${v}`,
  detail: `${stocks.filter((d) => d.symbol === v).length} cours`,
}));
---

<Layout title="Rendu statique · Marchés">
  <PageHeader surtitre="Marchés · Rendu statique" titre="Rendu statique" intro="Ces pages sont générées au build : getStaticPaths() liste les symboles et Astro produit un fichier HTML pour chacun.">
    <ModeSwitch dataset="marches" />
  </PageHeader>

  <ChoixValeurs items={items} variante="cartes" titre="Choisir une action" />

  <div class="mt-12">
    <Encart titre="Pages générées au build" ton="info">
      <p>getStaticPaths() renvoie la liste des valeurs du paramètre ; une page est créée pour chacune.</p>
      <pre><code>{`export function getStaticPaths() {
  return valeurs.map((v) => ({ params: { symbol: String(v) } }));
}`}</code></pre>
    </Encart>
  </div>
</Layout>

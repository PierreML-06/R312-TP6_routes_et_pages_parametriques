---
export const prerender = false;

import Layout from "../../../layouts/Layout.astro";
import PageHeader from "../../../components/ui/PageHeader.astro";
import ModeSwitch from "../../../components/ui/ModeSwitch.astro";
import ChoixValeurs from "../../../components/ui/ChoixValeurs.astro";
import Encart from "../../../components/ui/Encart.astro";
import climate from "../../../data/climate.json";

const valeurs = [...new Set(climate.map((d) => Math.floor(d.year / 10) * 10))].sort((a, b) => a - b);
const items = valeurs.map((v) => ({
  href: `/climat/rendu-dynamique/${v}`,
  label: `Années ${v}`,
  detail: `${climate.filter((d) => Math.floor(d.year / 10) * 10 === v).length} années`,
}));
---

<Layout title="Rendu dynamique · Climat">
  <PageHeader surtitre="Climat · Rendu dynamique" titre="Rendu dynamique" intro="Ces pages ne sont pas générées au build : le serveur produit le HTML à chaque requête, à partir de la décennie lue dans l'URL.">
    <ModeSwitch dataset="climat" />
  </PageHeader>

  <ChoixValeurs items={items} variante="cartes" titre="Choisir une décennie" />

  <div class="mt-12">
    <Encart titre="Page rendue à la demande" ton="info">
      <p>Avec prerender = false, Astro calcule la page à chaque visite et lit le paramètre avec Astro.params.</p>
      <pre><code>{"export const prerender = false;\nconst { decennie } = Astro.params;"}</code></pre>
      <p class="mt-3">Marque Plot utilisée : Plot.barY dessine une barre par année (x en bande) dont la hauteur est l'anomalie ; la couleur est bleue sous zéro, rouge au-dessus, et Plot.ruleY([0]) trace la référence.</p>
    </Encart>
  </div>
</Layout>
